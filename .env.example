# --- LLM ---
DR_LLM_PROVIDER=ollama            # anthropic | openai_compat | ollama
DR_LLM_MODEL=llama3.1
DR_LLM_BASE_URL=http://localhost:11434
DR_LLM_API_KEY=
DR_LLM_TEMPERATURE=0.2
DR_LLM_MAX_TOKENS=4096

# --- SEARCH ---
DR_SEARCH_PROVIDER=duckduckgo     # tavily | brave | searxng | duckduckgo (keyless)
DR_TAVILY_API_KEY=
DR_BRAVE_API_KEY=
DR_SEARXNG_BASE_URL=

# --- DECISION ENGINE ---
DR_DECISION_ENGINE=laya           # laya | llm
DR_DECISION_LAYA_DECISIONS=is_relevant   # decisioni girate su laya (benchmark Fase 2)
DR_LAYA_MIN_CONFIDENCE=0.35
DR_LAYA_MODEL=
# vuoto = Router auto-routing
DR_LAYA_MAX_LEN=0
# 0 = default del modello

# --- LIMITS ---
DR_MAX_CYCLES=3
DR_MAX_QUERIES_PER_CYCLE=6
DR_MAX_PAGES_PER_QUERY=5
DR_MAX_TOTAL_PAGES=30
DR_MAX_RUNTIME_SECONDS=600
DR_MAX_CONCURRENCY=8

# --- FETCH ---
DR_FETCH_TIMEOUT_S=20
DR_FETCH_USER_AGENT=DeepResearcher/0.1 (local research agent)
DR_PER_DOMAIN_MIN_INTERVAL_S=1.0
DR_RESPECT_ROBOTS=true

# --- STORAGE ---
DR_DB_PATH=data/deep_researcher.db
DR_CACHE_ENABLED=true
DR_CACHE_DIR=data/cache
DR_DOMAIN_BLOCKLIST=
